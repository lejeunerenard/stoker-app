{
  "name": "stoker-app",
  "productName": "StokerApp",
  "version": "1.0.0",
  "upgrade": "pear://o6ik83o3mr5yccmb96uunfqg9z1t5uccnukmrfbhokjwsrkkazky",
  "description": "An app for tracking and controlling a stoker for grills & smokers.",
  "license": "MIT",
  "author": "Sean Zellmer <sean@lejeunerenard.com> (http://lejeunerenard.com/)",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "renderbuild": "node renderbuild.mjs",
    "lint": "eslint --ignore-pattern **/bundle.js electron workers renderer",
    "test": "npm run lint; tape tests/**.js tests/**.mjs",
    "start": "npm run renderbuild && electron-forge start -- --no-updates",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "install:all": "npm i --ignore-scripts=true && npm run postinstall:all",
    "install:mac": "npm i --ignore-scripts=true && npm run postinstall:mac",
    "postinstall:all": "npm run install:electron",
    "postinstall:mac": "npm run postinstall:all && npm run install:macos-alias && npm run install:fs-xattr",
    "install:electron": "node node_modules/electron/install.js",
    "install:macos-alias": "cd node_modules/macos-alias && node-gyp rebuild",
    "install:fs-xattr": "cd node_modules/fs-xattr && node-gyp rebuild"
  },
  "keywords": [],
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "electron": "^42.0.1",
    "esbuild-wasm": "^0.25.0",
    "eslint": "^7.14.0",
    "eslint-config-standard": "^16.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "express": "^4.21.1",
    "tape": "^5.7.2",
    "test-tmp": "^1.4.0"
  },
  "dependencies": {
    "bare-assert": "^1.1.0",
    "bare-events": "^2.4.2",
    "bare-fs": "^4.0.1",
    "bare-http1": "^4.0.4",
    "bare-path": "^3.1.2",
    "bare-querystring": "^1.0.0",
    "bare-storage": "^1.1.0",
    "bare-stream": "^2.2.1",
    "chart.js": "^2.9.4",
    "choo": "^7.1.0",
    "choo-devtools": "^3.0.4",
    "corestore": "^7.15.0",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hrpc": "^4.1.0",
    "hypercore-storage": "^1.14.0",
    "hyperdb": "^4.16.1",
    "hyperschema": "^1.14.0",
    "hyperswarm": "^4.17.2",
    "paparam": "^1.10.0",
    "pear": "^3.0.0",
    "pear-runtime": "^1.3.1",
    "which-runtime": "^1.4.0"
  },
  "allowScripts": {
    "electron@42.0.1": true,
    "electron-winstaller": false
  },
  "imports": {
    "assert": {
      "bare": "bare-assert",
      "default": "assert"
    },
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "http": {
      "bare": "bare-http1",
      "default": "http"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "querystring": {
      "bare": "bare-querystring",
      "default": "querystring"
    }
  }
}
