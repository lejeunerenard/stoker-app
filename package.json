{
  "name": "stoker-app",
  "version": "1.0.0",
  "description": "",
  "main": "src/public/index.html",
  "pear": {
    "name": "stoker-app",
    "type": "desktop",
    "gui": {}
  },
  "scripts": {
    "build": "node build.mjs",
    "update-env": "echo '{ \"code_version\": \"'`git rev-parse HEAD`'\"}' > src/env.json",
    "lint": "eslint src/**/*.js",
    "test": "npm run lint; tape tests/**.js tests/**.mjs",
    "start": "npm run update-env; cross-env ELECTRON_ENV=development electron-forge start",
    "package": "npm run update-env; electron-forge package",
    "make": "npm run update-env; electron-forge make"
  },
  "keywords": [],
  "author": "Sean Zellmer <sean@lejeunerenard.com> (http://lejeunerenard.com/)",
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^7.14.0",
    "eslint-config-standard": "^16.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "tape": "^5.7.2",
    "test-tmp": "^1.4.0"
  },
  "dependencies": {
    "axios": "^0.21.0",
    "chart.js": "^2.9.4",
    "choo": "^7.1.0",
    "choo-devtools": "^3.0.4",
    "electron-store": "^6.0.1",
    "express": "^4.21.1",
    "hyperdb": "^4.16.1",
    "hyperschema": "^1.14.0",
    "mkdirp": "^1.0.4",
    "ws": "^7.5.10"
  }
}
